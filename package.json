{
	"name": "nav-dekoratoren",
	"version": "0.0.1",
	"private": "true",
	"description": "",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "pnpm -r --parallel run test",
		"lint": "pnpm -r --parallel run lint",
		"lint:client": "pnpm --filter decorator-client run lint",
		"lint:server": "pnpm --filter decorator-server run lint",
		"lint:icons": "pnpm --filter decorator-icons run lint",
		"lint:shared": "pnpm --filter decorator-shared run lint",
		"lint:next": "pnpm --filter next-pages-router-example run lint",
		"dev": "concurrently \"pnpm --filter decorator-client run dev\" \"pnpm --filter decorator-server run dev\"",
		"example": "pnpm --filter next-pages-router-example run dev",
		"build": "pnpm --filter decorator-icons run build && pnpm --filter decorator-client run build && pnpm --filter decorator-server run build && pnpm run copy-assets",
		"copy-assets": "node scripts/copy-assets.mjs",
		"prepare": "husky",
		"benchmarking": "./benchmarking/run",
		"playwright": "pnpm exec playwright test",
		"test:e2e": "node packages/server/scripts/setup-env.mjs --overwrite && playwright test",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@types/umami": "2.10.1",
		"clsx": "2.1.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "9.39.5",
		"@navikt/browserslist-config": "^0.1.0",
		"@playwright/test": "1.64.1",
		"@storybook/addon-docs": "10.5.5",
		"@storybook/html": "10.5.5",
		"@storybook/html-vite": "10.5.5",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "8.65.0",
		"@typescript-eslint/parser": "8.65.0",
		"concurrently": "9.2.4",
		"esbuild-minify-templates": "catalog:",
		"eslint": "catalog:",
		"http-server": "14.1.1",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"oxfmt": "0.66.0",
		"postcss-import-sync2": "1.2.0",
		"storybook": "10.5.5",
		"typescript": "catalog:",
		"typescript-plugin-css-modules": "5.2.0",
		"vite": "7.3.6"
	},
	"lint-staged": {
		"*.{ts,tsx,js}": [
			"eslint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"!(*.{ts,tsx,js})": [
			"oxfmt --no-error-on-unmatched-pattern"
		]
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"dependencyComments": {
		"storybook": "Need to have matching storybook version across all storybook packages for it to work properly."
	}
}
